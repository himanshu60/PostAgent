# LLM Provider (openrouter | ollama | gemini)
LLM_PROVIDER=openrouter
LLM_MODEL=google/gemma-2-9b-it
# Automatic fallback: if the primary provider errors (quota, rate limit,
# outage), calls transparently retry against this provider. Empty to disable.
LLM_FALLBACK_PROVIDER=ollama

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Ollama (fallback)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b

# MongoDB (separate cluster for agent data)
MONGO_URI=mongodb://username:password@host:port/database?authSource=admin
MONGO_DB=linkedin_agent
MONGO_POOL_MAX=10
MONGO_POOL_MIN=1
MONGO_TIMEOUT=5s

# LinkedIn API
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8080/auth/callback
LINKEDIN_PERSON_ID=
# LinkedIn API version (YYYYMM). Bump if you get HTTP 426 NONEXISTENT_VERSION.
LINKEDIN_API_VERSION=202506

# Gemini (text + image generation)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image

# Image generation (pollinations = free/no key, gemini/openai = high quality)
IMAGE_PROVIDER=pollinations
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1

# Auto-generate: checker runs daily at 9 AM; generates only for the next
# publish day (AGENT_PUBLISH_DAYS) if it has no post scheduled yet. Posts go
# live at 10 AM IST on publish days. Max one scheduled post per calendar day.
AGENT_SCHEDULE=CRON_TZ=Asia/Kolkata 0 0 9 * * *
AGENT_PUBLISH_DAYS=Mon,Wed,Fri
AGENT_TOPICS_COUNT=5
AGENT_AUTO_PUBLISH=false

# Brand Voice
BRAND_VOICE_TONE=professional
BRAND_VOICE_MAX_EMOJI=3
BRAND_VOICE_MIN_LINE_BREAKS=3

# Logging
LOG_LEVEL=info
